{
	"name": "haxe-terraform",
	"dockerComposeFile": "docker-compose.yml",
	"service": "workspace",
	"workspaceFolder": "/workspace",
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"nadako.vshaxe",
				"OpenTofu.vscode-opentofu",
				"earthly.earthfile-syntax-highlighting",
			],
		}
	},
	"remoteUser": "vscode"
}